# Safari-Ops — copy to .env and fill in. Never commit .env.
# Production: DJANGO_SETTINGS_MODULE=config.settings.production (set in the systemd unit).

SECRET_KEY=change-me-to-a-long-random-string      # python -c "import secrets; print(secrets.token_urlsafe(50))"
DEBUG=False
ALLOWED_HOSTS=ops.example.com
SITE_URL=https://ops.example.com                 # absolute links in emails (quotes, password reset)
CSRF_TRUSTED_ORIGINS=https://ops.example.com

# Database (MySQL 8)
DB_ENGINE=django.db.backends.mysql
DB_NAME=safariops
DB_USER=safariops
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# Legacy PHP database — only needed for import_legacy_data / sync_legacy_data
LEGACY_DB_NAME=
LEGACY_DB_USER=
LEGACY_DB_PASSWORD=
LEGACY_DB_HOST=localhost
LEGACY_DB_PORT=3306

# Cache shared by all gunicorn workers (lockouts, throttles, settings).
# dbcache needs: python manage.py createcachetable
CACHE_URL=dbcache://django_cache
WEB_CONCURRENCY=3

# Outgoing email (Hostinger: port 465 + EMAIL_USE_SSL=True)
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Safari-Ops <no-reply@example.com>
ADMINS=Ops Team:ops@example.com                  # receives 500-error reports

# External sites calling the API (comma-separated origins)
CORS_ALLOWED_ORIGINS=
JWT_ACCESS_TOKEN_LIFETIME_MIN=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
SESSION_TIMEOUT_MINUTES=30
